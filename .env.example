# Copy to .env and fill in. Environment variables take precedence over .env.
# Never commit .env — it holds your app secret.

# Feishu self-built app credentials (Developer Console > Credentials & Basic Info)
FEISHU_COMMENT_BOT_APP_ID=
FEISHU_COMMENT_BOT_APP_SECRET=

# Answer backend: `deepseek` (default) or a local CLI (`claude`, `codex`, any command).
FEISHU_COMMENT_BOT_AGENT_BACKEND=deepseek
# Only used when the backend is a local command; can be an absolute path.
FEISHU_COMMENT_BOT_AGENT_COMMAND=claude

# Only needed when backend=deepseek
FEISHU_COMMENT_BOT_DEEPSEEK_API_KEY=
FEISHU_COMMENT_BOT_DEEPSEEK_MODEL=deepseek-chat

# Who may use the bot (the answer is not protected against prompt injection):
#   owner     - only the owner of the document being commented on (default)
#   allowlist - only the open_ids below
#   any       - anyone who can @-mention the bot
FEISHU_COMMENT_BOT_TRUST_MODE=owner
# Comma-separated open_ids, used when TRUST_MODE=allowlist. An empty list denies everyone.
# Your own open_id is logged when the bot answers you, or when it ignores you.
FEISHU_COMMENT_BOT_ALLOWED_USERS=
